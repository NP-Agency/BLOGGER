    <div>
      <p class="font-mono text-sm uppercase tracking-wide text-coral">Newsletter</p>
      <h2 class="mt-3 max-w-2xl font-display text-4xl font-normal leading-tight sm:text-5xl">
        A quieter inbox note for people building with attention.
      </h2>
