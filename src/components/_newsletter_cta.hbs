    <form class="space-y-3">
      <label class="sr-only" for="newsletter-email">Email address</label>
      <div class="flex overflow-hidden rounded-sm border border-white/20 bg-white">
        <input id="newsletter-email" class="min-w-0 flex-1 px-4 py-3 text-sm text-ink outline-none" type="email" placeholder="you@example.com"/>
        <button class="bg-coral px-5 text-sm font-medium text-ink" type="submit">Join</button>
