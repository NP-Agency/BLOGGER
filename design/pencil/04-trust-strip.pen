{
  "version": "2.11",
  "children": [
    {
      "type": "frame",
      "id": "trust001",
      "x": 80,
      "y": 80,
      "name": "04 Trust Strip - Prompt",
      "width": 1200,
      "fill": "$canvas-white",
      "layout": "vertical",
      "gap": 16,
      "padding": 32,
      "children": [
        {
          "type": "text",
          "id": "trust002",
          "name": "title",
          "fill": "$text-ink",
          "width": "fill_container",
          "content": "Trust Strip",
          "fontFamily": "$font-display",
          "fontSize": 48,
          "lineHeight": 1,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "trust003",
          "name": "usage-context",
          "fill": "$text-ink",
          "width": "fill_container",
          "content": "Used after the hero or inside product/proof sections to quietly show partner, client, publication, or credibility logos without turning the page into a card grid.",
          "fontFamily": "$font-body",
          "fontSize": 18,
          "lineHeight": 1.4,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "trust004",
          "name": "pencil-visual-prompt",
          "fill": "$text-ink",
          "width": "fill_container",
          "content": "Prompt: Using root DESIGN.MD as the primary design source and DESIGN.pen as the Pencil component library, create an editable trust-logo-strip component. Reuse the trust-logo-strip rules from DESIGN.MD. Create desktop and mobile variants. Use centered microcopy above a row of monochrome placeholder logos with generous horizontal spacing, thin optional rules, and no card containers. It must feel quiet, credible, and editorial. Target code file: src/components/_trust_strip.hbs.",
          "fontFamily": "$font-mono",
          "fontSize": 14,
          "lineHeight": 1.45,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "truscode",
          "name": "html-css-code-prompt",
          "fill": "$text-ink",
          "width": "fill_container",
          "content": "Code prompt: Convert this trust strip design into src/components/_trust_strip.hbs. Use the current .pen file as the visual source of truth, root DESIGN.MD as the design authority, DESIGN.pen as the component library reference, and tailwind.config.js as the code token source. Generate production-ready Hamlet Builder Handlebars markup with Tailwind CSS classes. Return only the partial markup for src/components/_trust_strip.hbs. Do not generate React, JSX, CSS Modules, Vue, external CSS frameworks, or unrelated JavaScript. Use semantic HTML and accessible attributes. Preserve Blogger dynamic behavior where relevant with Blogger/Hamlet tags and realistic placeholders only where dynamic data is unavailable. After copying the output into the repo, npm run build must pass.",
          "fontFamily": "$font-mono",
          "fontSize": 14,
          "lineHeight": 1.45,
          "fontWeight": "normal"
        }
      ]
    }
  ]
}
