{
  "version": "2.11",
  "children": [
    {
      "type": "frame",
      "id": "tax001",
      "x": 80,
      "y": 80,
      "name": "08 Taxonomy Filters - Prompt",
      "width": 1200,
      "fill": "$canvas-white",
      "layout": "vertical",
      "gap": 16,
      "padding": 32,
      "children": [
        {
          "type": "text",
          "id": "tax002",
          "name": "title",
          "fill": "$text-ink",
          "width": "fill_container",
          "content": "Taxonomy Filters",
          "fontFamily": "$font-display",
          "fontSize": 48,
          "lineHeight": 1,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "tax003",
          "name": "usage-context",
          "fill": "$text-ink",
          "width": "fill_container",
          "content": "Used above feeds, archive views, search results, and label pages to help readers scan or filter content by category/topic.",
          "fontFamily": "$font-body",
          "fontSize": 18,
          "lineHeight": 1.4,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "tax004",
          "name": "pencil-visual-prompt",
          "fill": "$text-ink",
          "width": "fill_container",
          "content": "Prompt: Using root DESIGN.MD as the primary design source and DESIGN.pen as the Pencil component library, create an editable taxonomy-filters component. Reuse blog-filter-chip and button-pill-outline patterns from DESIGN.pen. Create inactive, active, hover/focus, dense mobile wrap, and optional search-field variants. Use coral and soft-coral accents, rounded pill shapes, and clear wrapping behavior. Avoid tiny unreadable filters. Target code file: src/components/_taxonomy_filters.hbs.",
          "fontFamily": "$font-mono",
          "fontSize": 14,
          "lineHeight": 1.45,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "tax0code",
          "name": "html-css-code-prompt",
          "fill": "$text-ink",
          "width": "fill_container",
          "content": "Code prompt: Convert this taxonomy filters design into src/components/_taxonomy_filters.hbs. Use the current .pen file as the visual source of truth, root DESIGN.MD as the design authority, DESIGN.pen as the component library reference, and tailwind.config.js as the code token source. Generate production-ready Hamlet Builder Handlebars markup with Tailwind CSS classes. Return only the partial markup for src/components/_taxonomy_filters.hbs. Do not generate React, JSX, CSS Modules, Vue, external CSS frameworks, or unrelated JavaScript. Use semantic HTML and accessible attributes. Preserve Blogger dynamic behavior where relevant with Blogger/Hamlet tags and realistic placeholders only where dynamic data is unavailable. After copying the output into the repo, npm run build must pass.",
          "fontFamily": "$font-mono",
          "fontSize": 14,
          "lineHeight": 1.45,
          "fontWeight": "normal"
        }
      ]
    }
  ]
}
