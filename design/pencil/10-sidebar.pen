{
  "version": "2.11",
  "children": [
    {
      "type": "frame",
      "id": "side001",
      "x": 80,
      "y": 80,
      "name": "10 Sidebar - Prompt",
      "width": 1200,
      "fill": "$canvas-white",
      "layout": "vertical",
      "gap": 16,
      "padding": 32,
      "children": [
        {
          "type": "text",
          "id": "side002",
          "name": "title",
          "fill": "$text-ink",
          "width": "fill_container",
          "content": "Sidebar",
          "fontFamily": "$font-display",
          "fontSize": 48,
          "lineHeight": 1,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "side003",
          "name": "usage-context",
          "fill": "$text-ink",
          "width": "fill_container",
          "content": "Optional secondary column used for Blogger profile, labels, archive links, popular posts, newsletter capture, or ad slots. It should not dominate the article or feed.",
          "fontFamily": "$font-body",
          "fontSize": 18,
          "lineHeight": 1.4,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "side004",
          "name": "pencil-visual-prompt",
          "fill": "$text-ink",
          "width": "fill_container",
          "content": "Prompt: Using root DESIGN.MD as the primary design source and DESIGN.pen as the Pencil component library, create an editable sidebar component. Create modules for profile/about, label list, archive list, popular posts, small newsletter, and optional ad placeholder. Use thin dividers, compact headings, restrained typography, and generous but efficient spacing. Create desktop sidebar and mobile stacked variants. Target code file: src/components/_sidebar.hbs.",
          "fontFamily": "$font-mono",
          "fontSize": 14,
          "lineHeight": 1.45,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "sidecode",
          "name": "html-css-code-prompt",
          "fill": "$text-ink",
          "width": "fill_container",
          "content": "Code prompt: Convert this sidebar design into src/components/_sidebar.hbs. Use the current .pen file as the visual source of truth, root DESIGN.MD as the design authority, DESIGN.pen as the component library reference, and tailwind.config.js as the code token source. Generate production-ready Hamlet Builder Handlebars markup with Tailwind CSS classes. Return only the partial markup for src/components/_sidebar.hbs. Do not generate React, JSX, CSS Modules, Vue, external CSS frameworks, or unrelated JavaScript. Use semantic HTML and accessible attributes. Preserve Blogger dynamic behavior where relevant with Blogger/Hamlet tags and realistic placeholders only where dynamic data is unavailable. After copying the output into the repo, npm run build must pass.",
          "fontFamily": "$font-mono",
          "fontSize": 14,
          "lineHeight": 1.45,
          "fontWeight": "normal"
        }
      ]
    }
  ]
}
