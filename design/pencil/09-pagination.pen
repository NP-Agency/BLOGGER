{
  "version": "2.11",
  "children": [
    {
      "type": "frame",
      "id": "page001",
      "x": 80,
      "y": 80,
      "name": "09 Pagination - Prompt",
      "width": 1200,
      "fill": "$canvas-white",
      "layout": "vertical",
      "gap": 16,
      "padding": 32,
      "children": [
        {
          "type": "text",
          "id": "page002",
          "name": "title",
          "fill": "$text-ink",
          "width": "fill_container",
          "content": "Pagination",
          "fontFamily": "$font-display",
          "fontSize": 48,
          "lineHeight": 1,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "page003",
          "name": "usage-context",
          "fill": "$text-ink",
          "width": "fill_container",
          "content": "Used below feed, archive, search, and post pages to navigate older/newer posts or previous/next article content.",
          "fontFamily": "$font-body",
          "fontSize": 18,
          "lineHeight": 1.4,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "page004",
          "name": "pencil-visual-prompt",
          "fill": "$text-ink",
          "width": "fill_container",
          "content": "Prompt: Using root DESIGN.MD as the primary design source and DESIGN.pen as the Pencil component library, create an editable pagination component. Reuse text-link/button-secondary patterns and simple arrow icons from DESIGN.pen. Create feed older/newer variant and single-post previous/next variant. Use thin top rule, clear left/right alignment on desktop, stacked or full-width tap targets on mobile, and restrained text links rather than heavy buttons. Target code file: src/components/_pagination.hbs.",
          "fontFamily": "$font-mono",
          "fontSize": 14,
          "lineHeight": 1.45,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "pagecode",
          "name": "html-css-code-prompt",
          "fill": "$text-ink",
          "width": "fill_container",
          "content": "Code prompt: Convert this pagination design into src/components/_pagination.hbs. Use the current .pen file as the visual source of truth, root DESIGN.MD as the design authority, DESIGN.pen as the component library reference, and tailwind.config.js as the code token source. Generate production-ready Hamlet Builder Handlebars markup with Tailwind CSS classes. Return only the partial markup for src/components/_pagination.hbs. Do not generate React, JSX, CSS Modules, Vue, external CSS frameworks, or unrelated JavaScript. Use semantic HTML and accessible attributes. Preserve Blogger dynamic behavior where relevant with Blogger/Hamlet tags and realistic placeholders only where dynamic data is unavailable. After copying the output into the repo, npm run build must pass.",
          "fontFamily": "$font-mono",
          "fontSize": 14,
          "lineHeight": 1.45,
          "fontWeight": "normal"
        }
      ]
    }
  ]
}
