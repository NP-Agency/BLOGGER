{
  "version": "2.11",
  "children": [
    {
      "type": "frame",
      "id": "card001",
      "x": 80,
      "y": 80,
      "name": "06 Post Card - Prompt",
      "width": 1200,
      "fill": "$canvas-white",
      "layout": "vertical",
      "gap": 16,
      "padding": 32,
      "children": [
        {
          "type": "text",
          "id": "card002",
          "name": "title",
          "fill": "$text-ink",
          "width": "fill_container",
          "content": "Post Card",
          "fontFamily": "$font-display",
          "fontSize": 48,
          "lineHeight": 1,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "card003",
          "name": "usage-context",
          "fill": "$text-ink",
          "width": "fill_container",
          "content": "Reusable article preview used in the blog feed, related posts, sidebar popular posts, and archive/search results. It must handle long titles and missing images gracefully.",
          "fontFamily": "$font-body",
          "fontSize": 18,
          "lineHeight": 1.4,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "card004",
          "name": "pencil-visual-prompt",
          "fill": "$text-ink",
          "width": "fill_container",
          "content": "Prompt: Using root DESIGN.MD as the primary design source and DESIGN.pen as the Pencil component library, create an editable post-card component. Create variants: row with thumbnail, text-only row, compact sidebar card, and featured card if useful. Use category chip/date metadata, 24px-32px title, excerpt, optional rounded thumbnail, thin top/bottom rules, and restrained spacing. Avoid heavy shadows and decorative card stacking. Include desktop and mobile variants. Target code file: src/components/_post_card.hbs.",
          "fontFamily": "$font-mono",
          "fontSize": 14,
          "lineHeight": 1.45,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "cardcode",
          "name": "html-css-code-prompt",
          "fill": "$text-ink",
          "width": "fill_container",
          "content": "Code prompt: Convert this post card design into src/components/_post_card.hbs. Use the current .pen file as the visual source of truth, root DESIGN.MD as the design authority, DESIGN.pen as the component library reference, and tailwind.config.js as the code token source. Generate production-ready Hamlet Builder Handlebars markup with Tailwind CSS classes. Return only the partial markup for src/components/_post_card.hbs. Do not generate React, JSX, CSS Modules, Vue, external CSS frameworks, or unrelated JavaScript. Use semantic HTML and accessible attributes. Preserve Blogger dynamic behavior where relevant with Blogger/Hamlet tags and realistic placeholders only where dynamic data is unavailable. After copying the output into the repo, npm run build must pass.",
          "fontFamily": "$font-mono",
          "fontSize": 14,
          "lineHeight": 1.45,
          "fontWeight": "normal"
        }
      ]
    }
  ]
}
